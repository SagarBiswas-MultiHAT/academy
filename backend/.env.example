# MultiHAT Academy backend environment template.
# Copy to .env for local development or production, then replace ALL secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:localpassword123@localhost:5432/academy_db?schema=public"

# ─── JWT secrets (generate with: openssl rand -base64 64) ────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-256bit"
JWT_REFRESH_SECRET="change-me-refresh-secret-256bit"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
# Set to "production" on the Droplet — disables Swagger UI
NODE_ENV="development"

# ─── aamarPay Payment Gateway ────────────────────────────────────────────────
# Sandbox values for development (replace with live credentials after approval)
AAMARPAY_STORE_ID="aamarpaytest"
AAMARPAY_SIGNATURE_KEY="dbb74894e82415a2f7ff0ec3a97e4183"
# Sandbox:    https://sandbox.aamarpay.com
# Production: https://secure.aamarpay.com
AAMARPAY_BASE_URL="https://sandbox.aamarpay.com"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_123456789"
SENDER_EMAIL="academy@multihat.dev"

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Production:  https://academy.multihat.dev
FRONTEND_URL="http://localhost:3000"
# Production:  https://api.multihat.dev/api/v1
API_URL="http://localhost:5000/api/v1"

# ─── Wallet ──────────────────────────────────────────────────────────────────
WALLET_MIN_TOPUP_BDT="50"

# ─── PDF Generation ──────────────────────────────────────────────────────────
CERTIFICATE_TEMPLATE_DIR="templates"
CERTIFICATE_OUTPUT_DIR="generated/certificates"
