# ═══════════════════════════════════════════════════════════════
# MultiHAT Academy — Backend Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in production values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Database ─────────────────────────────────────────────────
# Production PostgreSQL connection string
# Replace YOUR_STRONG_DB_PASSWORD with a generated password
DATABASE_URL="postgresql://academy_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/academy_db?schema=public"

# ─── JWT Secrets ──────────────────────────────────────────────
# Generate with: openssl rand -base64 64
# Each secret MUST be unique and at least 32 characters
JWT_ACCESS_SECRET="GENERATE_WITH_openssl_rand_-base64_64"
JWT_REFRESH_SECRET="GENERATE_A_DIFFERENT_SECRET_HERE"

# ─── Server Configuration ────────────────────────────────────
PORT=5000
NODE_ENV="production"

# ─── aamarPay Payment Gateway ────────────────────────────────
# Sandbox: https://sandbox.aamarpay.com
# Live:    https://secure.aamarpay.com
AAMARPAY_STORE_ID="your_live_store_id"
AAMARPAY_SIGNATURE_KEY="your_live_signature_key"
AAMARPAY_BASE_URL="https://secure.aamarpay.com"

# ─── Email (Resend) ──────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_PRODUCTION_API_KEY"
SENDER_EMAIL="academy@multihat.dev"

# ─── URLs ─────────────────────────────────────────────────────
# The public URL of the frontend (used for CORS, email links, etc.)
FRONTEND_URL="https://academy.multihat.dev"

# ─── Wallet Configuration ────────────────────────────────────
# Minimum wallet top-up amount in BDT
WALLET_MIN_TOPUP_BDT="50"
