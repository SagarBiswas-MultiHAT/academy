# ═══════════════════════════════════════════════════════════════
# MultiHAT Academy — Frontend Production Environment Variables
# ═══════════════════════════════════════════════════════════════
# For Vercel: Add these in Project Settings → Environment Variables
# For self-hosted: Copy to .env.local
#   cp .env.example .env.local
# ═══════════════════════════════════════════════════════════════

# ─── API URL ──────────────────────────────────────────────────
# Points to the backend API base URL (include /api/v1)
NEXT_PUBLIC_API_URL=https://api.multihat.dev/api/v1

# ─── Site URL ─────────────────────────────────────────────────
# The public URL of this frontend (used for sitemap, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=https://academy.multihat.dev

# ─── Google Analytics (Optional) ─────────────────────────────
# Your GA4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
