# =========================================
# Root Production Environment Example
# =========================================
#
# Copy values into:
# - backend/.env
# - frontend/.env.production.local
#
# Never commit real secrets.

# -------------------------
# Backend (NestJS) - REQUIRED
# -------------------------

# Runtime
NODE_ENV=production
PORT=5000

# Database (Prisma / Postgres)
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5432/academy_db?schema=public"

# Auth (JWT)
JWT_ACCESS_SECRET="<CHANGE_ME_TO_A_LONG_RANDOM_STRING>"
JWT_REFRESH_SECRET="<CHANGE_ME_TO_A_LONG_RANDOM_STRING>"

# CORS / URLs
FRONTEND_URL="https://academy.yourdomain.com"

# Payments (aamarPay)
# Use sandbox during staging, production URL in prod.
AAMARPAY_STORE_ID="<YOUR_AAMARPAY_STORE_ID>"
AAMARPAY_SIGNATURE_KEY="<YOUR_AAMARPAY_SIGNATURE_KEY>"
AAMARPAY_BASE_URL="https://sandbox.aamarpay.com"

# Wallet rules
WALLET_MIN_TOPUP_BDT="50"

# Email (Resend)
RESEND_API_KEY="<YOUR_RESEND_API_KEY>"
SENDER_EMAIL="academy@yourdomain.com"

# -------------------------
# Frontend (Next.js) - REQUIRED
# -------------------------

# Public runtime config (exposed to browser)
NEXT_PUBLIC_SITE_URL="https://academy.yourdomain.com"
NEXT_PUBLIC_API_URL="https://academy.yourdomain.com/api/v1"

# Optional analytics
NEXT_PUBLIC_GA_ID=""

